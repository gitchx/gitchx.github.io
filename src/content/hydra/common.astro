---
interface Props {
	 label?: string;
}

const { label = 'Hydra visual' } = Astro.props;
---

<div class="hydra-canvas" data-hydra-canvas>
	<canvas aria-label={label}></canvas>
	<p class="hydra-status" role="status">Loading visual…</p>
</div>

<style>
	.hydra-canvas {
		position: relative;
		width: 100%;
		margin: 0 0 2rem;
		border-radius: 12px;
		overflow: hidden;
		background: #111;
		aspect-ratio: 16 / 9;
	}

	.hydra-canvas canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hydra-status {
		position: absolute;
		inset: 50% auto auto 50%;
		transform: translate(-50%, -50%);
		margin: 0;
		color: white;
		font-size: 0.9rem;
	}

	.hydra-canvas.is-ready .hydra-status {
		display: none;
	}
</style>
