---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import HydraPost from '../../layouts/HydraPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('hydra');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'hydra'>;

const post = Astro.props;
const { Content } = await render(post);
---

<HydraPost {...post.data}>
	<Content />
</HydraPost>
